# Optional overrides. Every value is public (it appears in the site's HTML) and has a default in the
# code, so the site builds without a .env file. Copy to .env.local to override locally, or set the
# same names in Vercel > Settings > Environment Variables.

# Google Analytics 4 measurement ID (default in src/lib/analytics.ts)
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity project ID (default in src/lib/analytics.ts)
NEXT_PUBLIC_CLARITY_ID=

# Early-access Google Form (defaults in src/lib/early-access.ts)
NEXT_PUBLIC_EARLY_ACCESS_FORM_ID=
NEXT_PUBLIC_EARLY_ACCESS_EMAIL_ENTRY=
NEXT_PUBLIC_EARLY_ACCESS_PHONE_ENTRY=
NEXT_PUBLIC_EARLY_ACCESS_HELP_ENTRY=
NEXT_PUBLIC_EARLY_ACCESS_SOURCE_ENTRY=

# Never put secrets (API keys, service account keys) in this repository.
